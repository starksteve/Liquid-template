# ─────────────────────────────────────────────────────────────────
# DataForge AI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# 1. Copy this file to .env  (rename: remove the .example part)
# 2. Fill in your GROQ_API_KEY
# 3. NEVER commit .env to Git — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Groq API (Free) ───────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (free options):
#   llama-3.3-70b-versatile   <- recommended, best quality
#   mixtral-8x7b-32768        <- fast, good for code
#   gemma2-9b-it              <- lightweight
GROQ_MODEL=llama-3.3-70b-versatile
