# ─────────────────────────────────────────────────────────────────
# Streamlit Cloud Secrets Template
# ─────────────────────────────────────────────────────────────────
# On Streamlit Cloud:
#   Go to your app → Settings → Secrets
#   Paste the content below (with your real values filled in)
#
# Do NOT commit secrets.toml with real keys — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"
